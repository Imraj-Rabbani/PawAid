# Copy to .env and fill in. Never commit the real .env.
# Anything here is built into the public bundle, so never put a secret in it.

# Google sign-in: the OAuth client ID from Google Cloud Console (same value as the backend's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile CAPTCHA on sign in and sign up: the widget's site key (the backend gets the secret key).
# For local testing, 1x00000000000000000000AA always passes.
VITE_TURNSTILE_SITE_KEY=
