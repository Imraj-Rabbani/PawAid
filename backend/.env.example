# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pawaid

# Signing key for login tokens, at least 32 random characters; the server won't start without it.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a login lasts
JWT_EXPIRY=7d

PORT=3000
# The frontend's URL, allowed to call the API
CORS_ORIGIN=http://localhost:5173
# Number of proxies in front of the app (1 behind Render, Railway, Nginx or Cloudflare).
# Leave 0 locally. Rate limiting reads the client IP through them.
TRUST_PROXY=0

# The login cookie. Set COOKIE_SECURE=true in production (HTTPS).
# Set COOKIE_SAME_SITE=none if the frontend and API are on different sites
# (e.g. pawaid.vercel.app and pawaid-api.onrender.com); lax works when they share one.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Google sign-in: the OAuth client ID from Google Cloud Console (same value as the frontend's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Cloudflare Turnstile CAPTCHA on sign in and sign up. Off while empty, so set it in production.
# Secret key from Cloudflare dashboard > Turnstile > your widget (the frontend gets the site key).
# For local testing, 1x0000000000000000000000000000000AA always passes.
TURNSTILE_SECRET_KEY=

# Cloudflare R2 bucket for uploaded images
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public URL the bucket's files are served from, e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# The frontend's address, used in links inside emails (password reset). Defaults to CORS_ORIGIN.
# APP_URL=https://pawaid.vercel.app

# R2 free tier guard: checks usage every 15 minutes, emails at R2_WARN_PERCENT of
# the monthly free tier and pauses uploads at R2_BLOCK_PERCENT. Off if the token is empty.
# Token: Cloudflare dashboard > My Profile > API Tokens > Create Custom Token,
# permission Account > Account Analytics > Read
CLOUDFLARE_API_TOKEN=
R2_WARN_PERCENT=80
R2_BLOCK_PERCENT=90
# Emails (usage alerts, password resets) go through Resend (resend.com).
# Without a verified domain, Resend only delivers to the address you signed up with,
# so password reset emails won't reach users until you verify a domain and set EMAIL_FROM.
RESEND_API_KEY=
# where usage alerts go
ALERT_EMAIL=
# EMAIL_FROM=PawAid <no-reply@yourdomain.com>
